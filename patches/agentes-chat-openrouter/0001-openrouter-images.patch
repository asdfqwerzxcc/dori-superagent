+  test("a tool result's picture and PDF go only to a model whose list says it reads that kind", async () => {
+    setOpenRouterModels(models());
+    const messages: ModelRequest["messages"] = [
+      { role: "user", content: "what is in the file?" },
+      { role: "assistant", content: [{ type: "tool_use", id: "t1", name: "read_file", input: {} }] },
+      {
+        role: "user",
+        content: [
+          {
+            type: "tool_result",
+            toolUseId: "t1",
+            content: "shot.png and doc.pdf",
+            images: [
+              { mediaType: "image/png", data: "UE5H" },
+              { mediaType: "application/pdf", data: "JVBERi0=", pages: 1, name: "doc.pdf" },
+            ],
+          },
+        ],
+      },
+    ];
+    const send = async (model: string) => {
+      const { fetcher, requests } = scripted({ body: sse([delta({ content: "a dog" }, "stop")]) });
+      const result = await call({ model, messages }, fetcher).result;
+      return { body: JSON.stringify(requests[0]?.body.messages), leftOut: result.imagesLeftOut };
+    };
+    const both = await send("~openai/gpt-luna-latest");
+    expect(both.body).toContain('"type":"image_url"');
+    expect(both.body).toContain('"type":"file"');
+    expect(both.body).toContain('"filename":"doc.pdf"');
+    expect(both.body).toContain("data:application/pdf;base64,JVBERi0=");
+    expect(both.leftOut).toBeUndefined();
+    const vision = await send("~deepseek/deepseek-flash-latest");
+    expect(vision.body).toContain('"type":"image_url"');
+    expect(vision.body).not.toContain('"type":"file"');
+    expect(vision.body).toContain("The PDF is not shown to you");
+    expect(vision.leftOut).toBe(true);
+    const textOnly = await send("~z-ai/glm-latest");
+    expect(textOnly.body).not.toContain('"type":"image_url"');
+    expect(textOnly.body).not.toContain('"type":"file"');
+    expect(textOnly.body).toContain("The picture and the PDF is not shown to you");
+    expect(textOnly.leftOut).toBe(true);
+  });
+
   test("Claude gets cache breakpoints; a schema goes as strict JSON only to providers that honor it", async () => {
