+/** A self-hosted GitLab at `gitlab.test`: its git endpoints, and its merge base (as plain refs `a...b`). */
+function fakeGitLab(options: { mergeBase?: Record<string, string> } = {}) {
+  const calls: { url: string; method: string; auth: string | null; token: string | null; body: number }[] = [];
+  const fetch = (async (input: string | URL | Request, init?: RequestInit) => {
+    const url = String(input);
+    const headers = new Headers(init?.headers);
+    const body = init?.body ? ((init.body as Uint8Array).byteLength ?? 0) : 0;
+    calls.push({
+      url,
+      method: init?.method ?? "GET",
+      auth: headers.get("authorization"),
+      token: headers.get("private-token"),
+      body,
+    });
+    if (url.includes("/info/refs")) {
+      return new Response("001e# service=git-upload-pack\n0000", {
+        headers: { "content-type": "application/x-git-upload-pack-advertisement" },
+      });
+    }
+    if (url.endsWith("/git-upload-pack"))
+      return new Response("0008NAK\n", { headers: { "content-type": "application/x-git-upload-pack-result" } });
+    if (url.endsWith("/git-receive-pack"))
+      return new Response("000eunpack ok\n0000", {
+        headers: { "content-type": "application/x-git-receive-pack-result" },
+      });
+    const mergeBase = /\/projects\/[^/]+\/repository\/merge_base\?refs%5B%5D=([0-9a-f]+)&refs%5B%5D=([0-9a-f]+)$/.exec(
+      url,
+    );
+    if (mergeBase)
+      return Response.json({ id: options.mergeBase?.[`${mergeBase[1]}...${mergeBase[2]}`] ?? mergeBase[1] });
+    return new Response("not found", { status: 404 });
+  }) as typeof globalThis.fetch;
+  return { fetch, calls, gitUrl: "https://gitlab.test", apiUrl: "https://gitlab.test/api/v4", options };
+}
