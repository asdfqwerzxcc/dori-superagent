diff --git a/packages/engine/src/git/gitlab.ts b/packages/engine/src/git/gitlab.ts
new file mode 100644
index 0000000..65a7465
--- /dev/null
+++ b/packages/engine/src/git/gitlab.ts
@@ -0,0 +1,56 @@
+import type { ConnectorConnection, ConnectorDeps } from "../connectors/connections";
+import { openConnectionSecret } from "../connectors/connections";
+
+/**
+ * A self-hosted GitLab (ADR 0024, extended): the connection's `serverUrl` is the instance's base URL, its encrypted
+ * key is a personal, project or group access token, and both the proxy and its API calls resolve their addresses and
+ * header from it. The token never leaves the server: a computer gets our `agtgit1` credential, as for GitHub.
+ */
+export const GITLAB_CONNECTOR = "gitlab";
+
+/** The instance's base URL (trailing slashes gone) and its REST API under it. */
+export function gitlabUrls(connection: Pick<ConnectorConnection, "serverUrl">) {
+  const gitUrl = connection.serverUrl.replace(/\/+$/, "");
+  return { gitUrl, apiUrl: `${gitUrl}/api/v4` };
+}
+
+/** GitLab's git-over-HTTPS sign-in: HTTP Basic with the token as the password (any username; `oauth2` is ours). */
+export const gitlabGitAuth = (token: string) => `Basic ${Buffer.from(`oauth2:${token}`).toString("base64")}`;
+
+/** A REST call to GitLab: its personal, project or group token in `PRIVATE-TOKEN`, named as our own. */
+export const gitlabHeaders = (token: string): Record<string, string> => ({
+  "private-token": token,
+  "user-agent": "agentes.chat",
+});
+
+/** The connection's token, server side only: never a view, never a computer. Null when it has none. */
+export async function gitlabToken(connectors: ConnectorDeps, connection: ConnectorConnection): Promise<string | null> {
+  const secret = await openConnectionSecret(connectors.keyWrappers, connection);
+  return secret?.apiKey?.trim() || secret?.accessToken?.trim() || null;
+}
+
+/**
+ * Whether `ancestorOid` is on `tipOid`'s history, asked through GitLab's merge-base API (the proxy's fast-forward
+ * check once the pushed pack no longer reaches the old tip). Null when GitLab didn't answer: the caller refuses.
+ */
+export async function gitlabIsAncestor(
+  client: { apiUrl: string; fetch: typeof fetch },
+  token: string,
+  repo: { owner: string; repo: string },
+  ancestorOid: string,
+  tipOid: string,
+): Promise<boolean | null> {
+  const project = encodeURIComponent(`${repo.owner}/${repo.repo}`);
+  const refs = new URLSearchParams();
+  refs.append("refs[]", ancestorOid);
+  refs.append("refs[]", tipOid);
+  const res = await client
+    .fetch(`${client.apiUrl}/projects/${project}/repository/merge_base?${refs}`, {
+      headers: gitlabHeaders(token),
+      redirect: "manual",
+    })
+    .catch(() => null);
+  if (!res?.ok) return null;
+  const body = (await res.json().catch(() => null)) as { id?: unknown } | null;
+  return typeof body?.id === "string" ? body.id.toLowerCase() === ancestorOid.toLowerCase() : null;
+}
