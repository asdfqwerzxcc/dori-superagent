+    await expect(make({ connector: "gitlab", apiKey: "glpat_secret_123456" })).rejects.toBeInstanceOf(ValidationError);
+    await expect(make({ connector: "gitlab", serverUrl: "https://gitlab.test" })).rejects.toBeInstanceOf(
+      ValidationError,
+    );
+    await expect(
+      make({ connector: "gitlab", serverUrl: "https://gitlab.test/?x=1", apiKey: "glpat_secret_123456" }),
+    ).rejects.toBeInstanceOf(ValidationError);
+    await expect(
+      make({ connector: "github", serverUrl: "https://gitlab.test", apiKey: "ghp_secret_123456" }),
+    ).rejects.toBeInstanceOf(ValidationError);
+    await expect(
+      make({ connector: "gitlab", serverUrl: "http://gitlab.test", apiKey: "glpat_secret_123456" }),
+    ).rejects.toBeInstanceOf(ValidationError);
+
+    const connection = await make({
+      connector: "gitlab",
+      serverUrl: "https://gitlab.example.com/gitlab/",
+      apiKey: "glpat_secret_123456",
+    });
+    const row = (await f.db.select().from(schema.connectorConnections)).find((c) => c.id === connection.id);
+    if (!row) throw new Error("the connection row is missing");
+    expect(row.serverUrl).toBe("https://gitlab.example.com/gitlab/");
+    expect(JSON.stringify(row)).not.toContain("glpat_secret_123456");
+    expect(JSON.stringify(connectionView(row))).not.toContain("glpat_secret_123456");
+    expect(gitlabUrls(row)).toEqual({
+      gitUrl: "https://gitlab.example.com/gitlab",
+      apiUrl: "https://gitlab.example.com/gitlab/api/v4",
+    });
+    expect(await gitlabToken(depsOf(f), row)).toBe("glpat_secret_123456");
+
+    await setAgentScopes(
+      f.db,
+      f.owner.id,
+      f.org.id,
+      f.agent.id,
+      [{ connectionId: connection.id, scope: "gitlab:git.read" }],
+      connectorGrantValidator,
+    );
+    const grant = (await f.db.select().from(schema.agentScopes)).find((s) => s.connectionId === connection.id);
+    expect(grant?.scope).toBe("gitlab:git.read");
+  });
