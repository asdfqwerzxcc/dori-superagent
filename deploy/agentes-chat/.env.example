# agentes.chat self-host configuration.
#
# Copy this file to .env (chmod 600 .env), fill the three required values,
# then run: docker compose up -d
#
# Every variable here is read by Docker Compose or docker-compose.yml. Optional variables the
# app supports beyond this list can be added to .env and reach the app as-is;
# the full upstream list is .env.example at
# https://github.com/agentes-chat/agentes-chat/blob/v0.1.2/.env.example

# --- Required ---
# Database password. The compose file builds the app's DATABASE_URL from it,
# so keep it hex (no characters that need URL-encoding).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Master secret: signs sessions and derives the key that encrypts every
# stored provider and connector credential. Changing it makes those
# credentials unreadable. Back it up apart from the database.
# Generate: openssl rand -base64 48
AGENTES_SECRET=

# The exact address people open, scheme, host and port included, with no
# trailing slash. Sign-in cookies, the allowed browser origin and every link
# the app sends come from it.
# Examples: https://chat.example.com, https://agentes.tail1234.ts.net,
#           http://localhost:3000
# With the https profile, upstream creates the owner over localhost first:
# start with http://localhost:3000, create the owner, then change this to
# https://DOMAIN and run docker compose up -d again.
PUBLIC_URL=

# --- Image pin ---
# Pinned release. Keep this value unless deliberately upgrading; see
# upgrade.md for how to resolve the digest of a new tag.
AGENTES_IMAGE=ghcr.io/agentes-chat/agentes:0.1.2@sha256:d6bde5d5b68510a7d8a309b0491ec1431ffeeb815f019c2b9bdaf269e004ad4f

# --- Reach and port ---
# Profiles, comma-separated. Empty: http://127.0.0.1:3000 on this machine
# only. tailscale: private HTTPS on your tailnet. https: public DOMAIN with
# Caddy on ports 80 and 443. speech and embeddings: the local services.
# Examples: tailscale; https; https,speech,embeddings
COMPOSE_PROFILES=

# Where Docker publishes the app. Loopback by default: Docker opens published
# ports past the host firewall, so do not use 0.0.0.0 without TLS in front.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3000

# The most memory the app's container may take, swap included.
AGENTES_MEMORY=8g

# --- HTTPS with Caddy (COMPOSE_PROFILES=https) ---
# The public domain Caddy gets a Let's Encrypt certificate for. DNS must
# point at this server and ports 80 and 443 must be open.
DOMAIN=

# --- Tailscale (COMPOSE_PROFILES=tailscale) ---
# Auth key or OAuth client secret used to join the tailnet. It is read only
# until the node has joined; empty it afterwards.
# Generate at https://console.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# The server's name in your tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=agentes
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:agentes
TS_EXTRA_ARGS=
# true opens the instance to the internet at the same ts.net address.
# Only true or false; Compose refuses any other value.
TAILSCALE_FUNNEL=false

# --- Sign-in and members ---
# true lets anyone create an account. Keep false on an instance reachable
# from the internet: the first account owns the installation, and after it
# people join by invitation.
ALLOW_SIGNUP=false

# Other origins this instance is opened at, comma-separated (each http or
# https, host and port, no path). PUBLIC_URL is always trusted.
# Example: http://192.168.0.10:3000,https://agentes.tail1234.ts.net
EXTRA_TRUSTED_ORIGINS=

# While no account exists, only <PUBLIC_URL>/owner#claim=<token> creates the
# first one. Set this to the SHA-256 (hex) of a one-time token, and keep the
# token like a password until it is used.
# Generate:
#   token=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')
#   printf %s "$token" | openssl dgst -sha256 | sed 's/^.*= //'
# Owner link: <PUBLIC_URL>/owner#claim=<token>
OWNER_CLAIM_SHA256=

# Reverse proxies in front of this server (load balancer, Cloudflare, a CDN
# in front of your own proxy), comma-separated IPs/CIDRs. Leave empty when
# the app is reached directly, through Caddy, or through Tailscale.
TRUSTED_PROXIES=

# --- Email ---
# Transactional email: invitations, password reset, verification, budget and
# approval alerts. Without either email setting, emails are written to the
# app log and password reset stays off.
# SMTP example: smtps://user:password@smtp.example.com:465
# STARTTLS example: smtp://user:password@smtp.example.com:587
SMTP_URL=
# Sender, e.g. agentes.chat <ping@example.com>. Its domain must be verified
# with the email provider. Empty: agentes.chat <ping@HOST>, HOST being the
# host of PUBLIC_URL.
EMAIL_FROM=

# --- Google sign-in ---
# Enables "Sign in with Google" when both are set.
# Redirect URI: {PUBLIC_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Model providers ---
# agentes.chat needs no model key at boot. After the first sign-in, each
# organization adds its own keys in Settings -> AI and usage: Claude, OpenAI,
# Gemini, DeepSeek, Kimi, Z.ai, MiniMax, Command Code or OpenRouter. Usage and
# cost are recorded per agent. Keys are encrypted with AGENTES_SECRET and are
# never sent to browsers.
#
# Optional server-wide keys:
# Shared Claude key for workspaces without one of their own. Usage is still
# recorded per organization.
PLATFORM_ANTHROPIC_API_KEY=
# Jev, the small model that routes messages nobody @mentioned and judges
# memories and screens. Key: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# --- Local speech (COMPOSE_PROFILES=speech) ---
# Point the app at the local speech service. The audio stays on this machine.
LOCAL_SPEECH_URL=
# The key both sides use, if you set one. Empty: no key.
LOCAL_SPEECH_API_KEY=
# Engines tried in order, comma-separated (assemblyai, elevenlabs, soniox,
# groq, openai, local, deepinfra). Empty: every engine with a key, in that
# order. Example with a fallback: local,deepinfra
SPEECH_ENGINES=
SPEECH_WORKERS=2
SPEECH_THREADS=2
SPEECH_QUEUE=4
SPEECH_WAIT_SECONDS=3
SPEECH_LANGUAGE_MIN=0.7
# Docker refuses more CPUs than the machine has: set 2 on a 2-CPU server.
SPEECH_CPUS=4
SPEECH_MEMORY=4g

# --- Local embeddings (COMPOSE_PROFILES=embeddings, x86-64 only) ---
# none: full-text search only. openai: any OpenAI-compatible embeddings
# server; with the embeddings profile use http://embeddings:8080/v1.
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_URL=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# A local CPU can take a second or more per query; 3000 is a safer value
# with the embeddings profile.
EMBEDDINGS_QUERY_TIMEOUT_MS=1500
EMBEDDINGS_BATCH_TOKENS=2048
EMBEDDINGS_THREADS=2
EMBEDDINGS_CPUS=2
EMBEDDINGS_MEMORY=3g

# --- Privacy and logging ---
# Anonymous daily usage counts (people, agents, tokens, traffic). Never
# messages, files, names or sites. off stops the report.
TELEMETRY=on
# debug, info, warn or error.
LOG_LEVEL=info
